#define FXAA_REDUCE_MIN   (1.0/ 128.0)
#define FXAA_REDUCE_MUL   (1.0 / 8.0)
#define FXAA_SPAN_MAX	 8.0

float4 fxaa(sampler2D tex, float2 uv, float4 top, float4 bottom, float4 uCrop) {
			float2 inverseVP = float2(1.0 / 960.0, 1.0 / 544.0);
			float2 cropMin = uCrop.xy + 0.5 * inverseVP;
			float2 cropMax = uCrop.xy + uCrop.zw - 0.5 * inverseVP;
			float3 rgbNW = tex2D(tex, clamp(top.xy, cropMin, cropMax)).xyz;
			float3 rgbNE = tex2D(tex, clamp(top.zw, cropMin, cropMax)).xyz;
			float3 rgbSW = tex2D(tex, clamp(bottom.xy, cropMin, cropMax)).xyz;
			float3 rgbSE = tex2D(tex, clamp(bottom.zw, cropMin, cropMax)).xyz;
		float4 texColor = tex2D(tex, uv);
	float3 rgbM  = texColor.xyz;
	float3 luma = float3(0.299, 0.587, 0.114);
	float lumaNW = dot(rgbNW, luma);
	float lumaNE = dot(rgbNE, luma);
	float lumaSW = dot(rgbSW, luma);
	float lumaSE = dot(rgbSE, luma);
	float lumaM  = dot(rgbM,  luma);
	float lumaMin = min(lumaM, min(min(lumaNW, lumaNE), min(lumaSW, lumaSE)));
	float lumaMax = max(lumaM, max(max(lumaNW, lumaNE), max(lumaSW, lumaSE)));

	float2 dir;
	dir.x = -((lumaNW + lumaNE) - (lumaSW + lumaSE));
	dir.y =  ((lumaNW + lumaSW) - (lumaNE + lumaSE));

	float dirReduce = max((lumaNW + lumaNE + lumaSW + lumaSE) *
						  (0.25 * FXAA_REDUCE_MUL), FXAA_REDUCE_MIN);

	float rcpDirMin = 1.0 / (min(abs(dir.x), abs(dir.y)) + dirReduce);
	dir = min(float2(FXAA_SPAN_MAX, FXAA_SPAN_MAX),
			  max(float2(-FXAA_SPAN_MAX, -FXAA_SPAN_MAX),
			  dir * rcpDirMin)) * inverseVP;

		float3 rgbA = 0.5 * (
				tex2D(tex, clamp(uv + dir * (1.0 / 3.0 - 0.5), cropMin, cropMax)).xyz +
				tex2D(tex, clamp(uv + dir * (2.0 / 3.0 - 0.5), cropMin, cropMax)).xyz);
		float contrast = saturate((lumaMax - lumaMin) * 12.0 - 0.1);
		return float4(lerp(rgbM, rgbA, contrast), texColor.a);
}

float4 main(
	float2 vUv : TEXCOORD0,
	float4 vTop : TEXCOORD1,
	float4 vBottom : TEXCOORD2,
		uniform sampler2D iChannel0 : TEXUNIT0,
		uniform float4 uCrop) : COLOR
{
	return fxaa(iChannel0, vUv, vTop, vBottom, uCrop);
}
