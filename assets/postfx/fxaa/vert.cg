void main(
	float3 position,
	float2 texcoord,
	uniform float4x4 gl_ModelViewProjectionMatrix,
	out float4 vPosition : POSITION,
	out float2 vUv : TEXCOORD0,
	out float4 vTop : TEXCOORD1,
	out float4 vBottom : TEXCOORD2)
{
	vPosition = float4(position, 1.f);
	vUv = texcoord;
	float2 pixel = float2(1.0 / 960.0, 1.0 / 544.0);
	vTop = float4(texcoord + pixel * float2(-1.0, -1.0),
	              texcoord + pixel * float2(1.0, -1.0));
	vBottom = float4(texcoord + pixel * float2(-1.0, 1.0),
	                 texcoord + pixel * float2(1.0, 1.0));
}
